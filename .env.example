# Copy this file to .env and fill in your API keys

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Claude API Key (https://console.anthropic.com/)
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxx

# Google Gemini API Key (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Weather API Key (https://www.weatherapi.com) - Only needed for ConsoleAgent
WEATHER_API_DOTCOM_KEY=xxxxxxxxxxxxxxxxxxxx

# AI Provider Settings for Docker
AI_PROVIDER=openai  # Options: openai, claude, gemini
AI_MODEL=gpt-4.1-mini  # Or your preferred model